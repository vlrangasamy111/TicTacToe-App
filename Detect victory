public boolean checkWin(char symbol) {
    char[][] b = getBoard(); // use getter for encapsulation

    // Check rows and columns
    for (int i = 0; i < 3; i++) {
        // Row check
        if (b[i][0] == symbol && b[i][1] == symbol && b[i][2] == symbol) {
            return true;
        }

        // Column check
        if (b[0][i] == symbol && b[1][i] == symbol && b[2][i] == symbol) {
            return true;
        }
    }

    // Check diagonals
    if (b[0][0] == symbol && b[1][1] == symbol && b[2][2] == symbol) {
        return true;
    }

    if (b[0][2] == symbol && b[1][1] == symbol && b[2][0] == symbol) {
        return true;
    }

    return false; // No winning pattern found
}
