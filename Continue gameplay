public class TicTacToeGame {

    private TicTacToe game = new TicTacToe();
    private char currentPlayer = 'X'; // X = Human, O = Computer
    private boolean gameRunning = true;

    public void startGame() {

        game.printBoard();

        while (gameRunning) {

            System.out.println("Current Player: " + currentPlayer);

            if (currentPlayer == 'X') {
                playerMove(); // assume input handled here
            } else {
                game.computerMove('O');
            }

            game.printBoard();

            // Check win
            if (checkWin(currentPlayer)) {
                System.out.println(currentPlayer + " wins!");
                gameRunning = false;
            }
            // Check draw
            else if (isBoardFull()) {
                System.out.println("It's a draw!");
                gameRunning = false;
            }
            // Switch turn
            else {
                switchPlayer();
            }
        }
    }

    private void switchPlayer() {
        currentPlayer = (currentPlayer == 'X') ? 'O' : 'X';
    }

    // Dummy player input method (replace with Scanner logic)
    private void playerMove() {
        // Example fixed move — replace with real input
        game.updateBoard(0, 0, 'X');
    }

    // Check win conditions
    private boolean checkWin(char symbol) {
        char[][] b = game.board; // assuming board is accessible

        // Rows & Columns
        for (int i = 0; i < 3; i++) {
            if ((b[i][0] == symbol && b[i][1] == symbol && b[i][2] == symbol) ||
                (b[0][i] == symbol && b[1][i] == symbol && b[2][i] == symbol)) {
                return true;
            }
        }

        // Diagonals
        return (b[0][0] == symbol && b[1][1] == symbol && b[2][2] == symbol) ||
               (b[0][2] == symbol && b[1][1] == symbol && b[2][0] == symbol);
    }

    // Check draw
    private boolean isBoardFull() {
        char[][] b = game.board;

        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                if (b[i][j] == ' ') {
                    return false;
                }
            }
        }
        return true;
    }
}
