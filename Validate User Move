#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int get_player_slot() {
    int slot;
    printf("Enter slot number (1-9): ");
    scanf("%d", &slot);
    return slot;
}

void slot_to_indices(int slot, int *row, int *col) {
    *row = (slot - 1) / 3;
    *col = (slot - 1) % 3;
}

int is_valid_move(char board[3][3], int slot) {
    if (slot < 1 || slot > 9) return 0;
    int row = (slot - 1) / 3;
    int col = (slot - 1) % 3;
    return (board[row][col] == '-');
}

void print_board(char board[3][3]) {
    printf("  1 2 3\n");
    for (int i = 0; i < 3; i++) {
        printf("%d ", i + 1);
        for (int j = 0; j < 3; j++) {
            printf("%c ", board[i][j]);
            if (j < 2) printf("| ");
        }
        printf("\n");
        if (i < 2) printf("  ----+---+----\n");
    }
}

int main() {
    char board[3][3];
    char player1_symbol, player2_symbol;
    int current_player;
    
    // Initialize board
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            board[i][j] = '-';
        }
    }
    
    // Random toss
    srand(time(NULL));
    int toss = rand() % 2;
    if (toss == 0) {
        current_player = 1;
        player1_symbol = 'X';
        player2_symbol = 'O';
        printf("Toss: Player 1 starts! P1: X, P2: O\n\n");
    } else {
        current_player = 2;
        player2_symbol = 'X';
        player1_symbol = 'O';
        printf("Toss: Player 2 starts! P1: O, P2: X\n\n");
    }
    
    print_board(board);
    
    // Get move with validation loop
    int slot, row, col;
    char symbol;
    printf("\nCurrent player: Player %d\n", current_player);
    do {
        slot = get_player_slot();
        if (!is_valid_move(board, slot)) {
            printf("Invalid move! Slot out of range or already taken. Try again.\n");
            continue;
        }
        slot_to_indices(slot, &row, &col);
        symbol = (current_player == 1) ? player1_symbol : player2_symbol;
        board[row][col] = symbol;
        printf("Valid! Placed %c at Row:%d Col:%d\n\n", symbol, row, col);
        break;
    } while (1);
    
    // Show updated board
    print_board(board);
    
    return 0;
}
